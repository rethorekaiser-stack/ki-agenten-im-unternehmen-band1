# .env.example – Namen der Geheimnisse, die die Programmskelette lesen (Kapitel 14.6, Anhang B.7). Stand 03.11.2026.
# Diese Datei enthält KEINE Werte. Für die Entwicklung kopieren Sie sie nach .env (steht in .gitignore, nie einchecken)
# und tragen dort Testwerte ein. Im Betrieb stellt der Tresor die Werte als Umgebungsvariablen bereit.

# DL-113 DATEV-Beispielschnittstelle (nur nötig, wenn die Übertragung eingeschaltet ist; Standard: AUS)
# Wert im Tresor
DATEV_CLIENT_SECRET=

# DL-130 Programmskelett Orchestrierung (Zugang zur Plattform, wenn Sie rufe_agent_auf umsetzen)
# Wert im Tresor
MODELL_API_SCHLUESSEL=

# DL-901 Wissens-MCP-Server (nur mit Anmeldung, ANMELDUNG_AN = True)
# Wert im Tresor
WISSENSSERVER_ZUGANG=
